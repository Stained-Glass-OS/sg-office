diff --git a/DesktopEditor/doctrenderer/js_internal/v8/v8_base.h b/DesktopEditor/doctrenderer/js_internal/v8/v8_base.h
index a30f58ce..911e2372 100644
--- a/DesktopEditor/doctrenderer/js_internal/v8/v8_base.h
+++ b/DesktopEditor/doctrenderer/js_internal/v8/v8_base.h
@@ -24,7 +24,31 @@
 #include "libplatform/libplatform.h"
 
 #ifndef DISABLE_MEMORY_LIMITATION
+#ifdef SG_V8_LIBNODE
+// Stained Glass OS: Debian's V8 (libnode) does not ship V8's internal
+// src/base headers; the two memory figures come from the system instead.
+#include <unistd.h>
+#include <sys/resource.h>
+namespace sg_sysinfo
+{
+	inline int64_t AmountOfPhysicalMemory()
+	{
+		long pages = sysconf(_SC_PHYS_PAGES), size = sysconf(_SC_PAGESIZE);
+		return (pages > 0 && size > 0) ? (int64_t)pages * size : 0;
+	}
+	inline int64_t AmountOfVirtualMemory()
+	{
+		struct rlimit rl;
+		if (0 != getrlimit(RLIMIT_DATA, &rl) || RLIM_INFINITY == rl.rlim_cur)
+			return 0;
+		return (int64_t)rl.rlim_cur;
+	}
+}
+#define V8_SG_SYSINFO sg_sysinfo
+#else
 #include "src/base/sys-info.h"
+#define V8_SG_SYSINFO v8::base::SysInfo
+#endif
 #endif
 
 #ifdef V8_VERSION_89_PLUS
@@ -154,7 +178,7 @@ public:
 #endif
 
 		v8::V8::Dispose();
-	#ifdef V8_VERSION_121_PLUS
+	#if defined(V8_VERSION_121_PLUS) || defined(SG_V8_LIBNODE)
 		v8::V8::DisposePlatform();
 	#else
 		v8::V8::ShutdownPlatform();
@@ -191,12 +215,12 @@ public:
 		create_params.array_buffer_allocator = m_pAllocator;
 
 #ifndef DISABLE_MEMORY_LIMITATION
-		int64_t nMaxVirtualMemory = v8::base::SysInfo::AmountOfVirtualMemory();
+		int64_t nMaxVirtualMemory = V8_SG_SYSINFO::AmountOfVirtualMemory();
 		if (0 == nMaxVirtualMemory)
 			nMaxVirtualMemory = 4000000000; // 4Gb
 
 		create_params.constraints.ConfigureDefaults(
-					v8::base::SysInfo::AmountOfPhysicalMemory(),
+					V8_SG_SYSINFO::AmountOfPhysicalMemory(),
 					nMaxVirtualMemory);
 #endif
 
